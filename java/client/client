#!/usr/bin/env bash

set -eou pipefail

SERVER_URL=${SERVER_URL:-"localhost:8080"}
loginToken=""
rsaToken=""

echo $SERVER_URL

RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

login() {
    echo -e "${RED}Getting login token ${NC}"
    loginToken=$(curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 15 -X POST -H "Content-Type: application/json" -d '{"username": "admin", "password": "pass" }' "${SERVER_URL}/login" | jq -er ' .access_token | select(type == "string" and length > 0)')
    echo "Login token received"
    echo
}

rsaToken() {
    echo -e "${RED}Getting RSA token ${NC}"
    rsaToken=$(curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 15 -X POST -H "Content-Type: application/json" -d '{"username": "admin", "password": "pass" }' "${SERVER_URL}/rsaToken" | jq -er ' .access_token | select(type == "string" and length > 0)')
    echo "RSA token received"
    echo
}

projects() {
    echo -e "${BLUE}Getting projects ${NC}"
    curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 15 -X GET -H "Authorization: Bearer ${loginToken}" "${SERVER_URL}/api/projects"
    echo
    echo
}

random-project() {
    echo -e "${BLUE}Getting random project ${NC}"
    curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 15 -X GET -H "Authorization: Bearer ${loginToken}" "${SERVER_URL}/api/project"
    echo
    echo
}

project() {
    projects=("kubernetes" "prometheus" "envoy")
    id=${projects[ $RANDOM % ${#projects[@]} ]}

    echo -e "${BLUE}Getting project ${id} ${NC}"
    curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 15 -X GET -H "Authorization: Bearer ${loginToken}" "${SERVER_URL}/api/projects/${id}"
    echo
    echo
}

categories() {
    echo "Getting categories"
    curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 15 -H "Authorization: Bearer ${loginToken}" "${SERVER_URL}/api/categories"
    echo
}

interest() {
    echo -e "${BLUE}Getting max interest rate security ${NC}"
    curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 15 -X GET -H "Authorization: Bearer ${rsaToken}" "${SERVER_URL}/treasury/max_interest"
    echo
    echo
}

random-sleep () {
    sleep $(( RANDOM % 3 ))
}

i=0
while true; do
    if [[ $((i % 5)) == 0 ]]; then
        login
        rsaToken
    fi

    projects
    random-sleep

    random-project
    random-sleep

    project
    random-sleep

    categories
    random-sleep

    interest
    random-sleep
    i=$((i+1))
done
